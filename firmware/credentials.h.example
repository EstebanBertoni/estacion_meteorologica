// credentials.h.example — plantilla SIN valores reales
//
// Copiá este archivo como "credentials.h" en la misma carpeta del
// sketch y completá con tus datos reales. credentials.h está en
// .gitignore: jamás debe subirse al repositorio.
//
// En Arduino IDE: Flecha ▾ (junto a la pestaña del sketch) → New Tab
// → nombre: credentials.h

#pragma once

#define WIFI_SSID     "TU_RED_WIFI_2.4GHz"   // El ESP32 solo ve 2.4 GHz
#define WIFI_PASSWORD "TU_CONTRASEÑA"

// IP del equipo donde corre el broker Mosquitto (configuración de
// entorno: al migrar el backend solo se cambia esta línea).
#define MQTT_SERVER_ADDR "192.168.X.Y"
